# =============================================================================
# Engreídos Barbershop · Configuración del servidor
# Copia este archivo como «.env» y ajusta los valores.
# =============================================================================

# Puerto donde se abre la aplicación: http://localhost:3000
PUERTO=3000

# Conexión a MySQL
BD_HOST=localhost
BD_PUERTO=3306
BD_USUARIO=root
BD_CONTRASENA=
BD_NOMBRE=engreidos

# Zona horaria del negocio (México centro, sin horario de verano)
ZONA_HORARIA=America/Mexico_City
ZONA_HORARIA_MYSQL=-06:00

# Clave secreta para firmar las sesiones (JWT). Escribe una frase larga y
# única; si la cambias, todos tendrán que volver a iniciar sesión.
JWT_SECRETO=cambia-esta-frase-por-una-larga-y-secreta
# Horas que dura una sesión
JWT_HORAS=12

# Versión de la API de WhatsApp Cloud (Meta). El token y el número se
# configuran desde la app: Ajustes → WhatsApp.
WHATSAPP_API_VERSION=v23.0
